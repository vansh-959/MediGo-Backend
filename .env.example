# Copy this file to .env and fill in credentials locally. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB Atlas URI. URL-encode special characters in the password.
MONGODB_URI=

# Google AI Studio key; Gemini calls remain on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional integrations
GEOAPIFY_API_KEY=
EMERGENCY_HOSPITAL_EMAIL=
# Optional: JSON map of hospital id to that hospital emergency inbox.
EMERGENCY_HOSPITAL_EMAILS={}
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS OTP delivery. When configured, signup/sign-in codes go to the
# user's phone; password reset codes continue to use email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Use a long, random value outside local development.
JWT_SECRET=
CORS_ORIGINS=
